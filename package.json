{
  "name": "rez-launcher",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "REZ launcher — open-source, ultra-light desktop game launcher & playtime tracker (Tauri v2).",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "logo": "node scripts/render-logo.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
