{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REZ launcher",
  "version": "0.4.0",
  "identifier": "io.github.rezlauncher",
  "mainBinaryName": "REZ-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "REZ launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#09090b",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "REZ launcher contributors",
    "category": "Game",
    "shortDescription": "Open-source game launcher & playtime tracker",
    "longDescription": "REZ launcher is an ultra-light, open-source PC game launcher that tracks your exact playtime per game and helps you keep your drives tidy.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/reztsk/REZ-LAUNCHER",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NzgwMzA3RjIzMUU1NzYKUldSMjVUSHlCd040S2QyUmIwK21wbFIvaDU2aVFpWDFTVmhFREkrN01BTTJuVTdFUmp5SkwzMnoK",
      "endpoints": [
        "https://github.com/reztsk/REZ-LAUNCHER/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
