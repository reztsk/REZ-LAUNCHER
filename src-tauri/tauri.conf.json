{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameREZ",
  "version": "0.1.0",
  "identifier": "io.github.gamerez",
  "mainBinaryName": "GameREZ",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "GameREZ",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#07070d",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "GameREZ contributors",
    "category": "Game",
    "shortDescription": "Open-source game launcher & playtime tracker",
    "longDescription": "GameREZ is an ultra-light, open-source PC game launcher that tracks your exact playtime and helps you keep your drives tidy.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/reztsk/GameREZ",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
